<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- Spring Boot provides the DataSource – no JDBC properties needed here -->
    <persistence-unit name="default">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.kat.taskmanagement.entity.User</class>
        <class>com.kat.taskmanagement.entity.Project</class>
        <class>com.kat.taskmanagement.entity.Task</class>
        <class>com.kat.taskmanagement.entity.Comment</class>
        <class>com.kat.taskmanagement.entity.Attachment</class>
        <class>com.kat.taskmanagement.entity.Label</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
        </properties>
    </persistence-unit>

</persistence>

